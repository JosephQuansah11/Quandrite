{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    // The client is migrated file by file: it is emitted even while its own
    // types are still being filled in. `npm run typecheck` covers the server,
    // the shared contracts and the tests.
    "noCheck": true,
    "allowImportingTsExtensions": false,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": [],
    "rootDir": ".",
    "outDir": "build",
    "sourceMap": false,
    "declaration": false
  },
  "include": ["public/js/**/*.ts", "shared/**/*.ts"]
}
