{
  "name": "quandrite",
  "version": "0.1.0",
  "private": true,
  "description": "Quandrite - a WhatsApp + Zoom style communication tool with a multi-platform livestreaming studio",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "vite build && vite build --config vite.legacy.config.ts",
    "dev": "vite",
    "dev:api": "node --watch server/index.ts",
    "typecheck": "tsc -p tsconfig.server.json && node scripts/check-client.ts",
    "prestart": "npm run build",
    "start": "node server/index.ts",
    "pretest": "npm run build",
    "test": "node --test --test-concurrency=1",
    "test:unit": "node --test --test-concurrency=1 test/overlays.test.ts test/destinations.test.ts test/layout.test.ts test/time.test.ts test/quality.test.ts test/ffmpeg.test.ts test/studio.test.ts test/api.test.ts test/signaling.test.ts test/wiring.test.ts test/mailer.test.ts test/room-audio.test.ts test/audio.test.ts",
    "test:e2e": "node --test test/relay-e2e.test.ts",
    "clean": "node -e \"require('node:fs').rmSync('build',{recursive:true,force:true});require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "express": "^5.3.0",
    "ffmpeg-static": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^5.9.3",
    "vite": "^8.3.5"
  },
  "allowScripts": {
    "ffmpeg-static@5.3.0": true
  }
}
